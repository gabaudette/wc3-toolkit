---
// biome-ignore lint/correctness/noUnusedImports: Used in the Astro template, which Biome does not analyze.
import DefaultThemeProvider from "@astrojs/starlight/components/ThemeProvider.astro";
import { CODE_LANGUAGE_STORAGE_KEY } from "../codeLanguage";
import { CODE_THEME_STORAGE_KEY, CODE_THEMES } from "../codeThemes";

// biome-ignore lint/correctness/noUnusedVariables: Passed into the inline Astro script below.
const codeThemeConfig = {
  ids: CODE_THEMES.map((theme) => theme.id),
  storageKey: CODE_THEME_STORAGE_KEY,
  languageKey: CODE_LANGUAGE_STORAGE_KEY,
};
---

<script is:inline define:vars={{ codeThemeConfig }}>
  // Start in Workshop's graphite theme; preserve every explicit visitor preference.
  try {
    if (localStorage.getItem("starlight-theme") === null) {
      localStorage.setItem("starlight-theme", "dark");
    }
  } catch {
    // Storage can be blocked by browser privacy settings. Starlight then uses the system theme.
  }
  try {
    const stored = localStorage.getItem(codeThemeConfig.storageKey);
    let codeTheme = "auto";
    if (codeThemeConfig.ids.includes(stored)) {
      codeTheme = stored;
    }
    document.documentElement.dataset.codeTheme = codeTheme;
  } catch {
    document.documentElement.dataset.codeTheme = "auto";
  }
  try {
    let language = "lua";
    if (localStorage.getItem(codeThemeConfig.languageKey) === "jass") {
      language = "jass";
    }
    document.documentElement.dataset.codeLanguage = language;
  } catch {
    document.documentElement.dataset.codeLanguage = "lua";
  }
</script>
<DefaultThemeProvider />

<script>
  import "../externalLinks";
</script>
