{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WC3 Object Editor",
  "version": "0.1.0",
  "identifier": "io.github.gabaudette.wc3toolkit",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WC3 Object Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' wc3icon: http://wc3icon.localhost; connect-src 'self' ipc: http://ipc.localhost wc3tex: http://wc3tex.localhost wc3model: http://wc3model.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
